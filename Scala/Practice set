object CountOccurrences {
  def countOccurrences[A](list: List[A]): Map[A, Int] = {
    list.groupBy(identity).view.mapValues(_.size).toMap
  }

  def main(args: Array[String]): Unit = {
    val list = List(1, 2, 2, 3, 1, 4, 2, 3, 1)
    val counts = countOccurrences(list)
    println(counts)
    // Example output: Map(1 -> 3, 2 -> 3, 3 -> 2, 4 -> 1)
  }
}



