object LastThreeSum {
  def sumLastThree(arr: Array[Int]): Int = {
    if (arr.isEmpty) 0
    else if (arr.length < 3) arr.sum
    else arr.takeRight(3).sum
  }

  def main(args: Array[String]): Unit = {
    println(sumLastThree(Array(1, 2, 3, 4, 5)))   // 12
    println(sumLastThree(Array(10, 20)))          // 30
    println(sumLastThree(Array()))                // 0
    println(sumLastThree(Array(7)))               // 7
  }
}




