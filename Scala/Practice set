object ListPalindrome {
  def isPalindrome[A](list: List[A]): Boolean = {
    list == list.reverse
  }

  def main(args: Array[String]): Unit = {
    println(isPalindrome(List(1, 2, 3, 2, 1)))   // true
    println(isPalindrome(List("a", "b", "c")))   // false
    println(isPalindrome(List(1)))               // true
    println(isPalindrome(List.empty[Int]))       // true
  }
}




