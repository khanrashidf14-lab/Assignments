object MaxValueKeys {
  def keysWithMaxValue[K, V](map: Map[K, V])(implicit ord: Ordering[V]): Set[K] = {
    if (map.isEmpty) Set.empty
    else {
      val maxVal = map.values.max
      map.collect { case (k, v) if v == maxVal => k }.toSet
    }
  }

  def main(args: Array[String]): Unit = {
    val original = Map("Red" -> 1, "Green" -> 4, "Blue" -> 3, "Orange" -> 4)
    println("Original map: " + original)

    val result = keysWithMaxValue(original)
    println("The keys with the maximum value are: " + result)
    // Expected: Set(Green, Orange)
  }
}
