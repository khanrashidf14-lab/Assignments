import scala.io.StdIn

object ArrayAverage {
  def main(args: Array[String]): Unit = {
    print("Enter number of elements: ")
    val n = StdIn.readInt()

    val arr = new Array[Int](n)
    println(s"Enter $n integers:")
    for (i <- 0 until n) {
      arr(i) = StdIn.readInt()
    }

    if (n == 0) {
      println("Average: 0.0 (empty array)")
    } else {
      val avg = arr.sum.toDouble / n
      println(s"Average: $avg")
    }
  }
}





