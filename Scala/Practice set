object NextGreater {
  def replaceWithNextGreater(arr: Array[Int]): Array[Int] = {
    if (arr.isEmpty) return arr
    val result = arr.clone()
    var maxSoFar = -1

    // Traverse from right to left
    for (i <- arr.length - 1 to 0 by -1) {
      val current = result(i)
      result(i) = maxSoFar
      if (current > maxSoFar) maxSoFar = current
    }
    result
  }

  def main(args: Array[String]): Unit = {
    val original = Array(58, 27, 100, 24, -5, 2, -6)
    println("Original array: " + original.mkString(", "))

    val modified = replaceWithNextGreater(original)
    println("Modified array: " + modified.mkString(", "))
    // Expected: 100, 100, 24, 2, 2, -6, -1
  }
}




