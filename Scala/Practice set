object ArraySum {
  def main(args: Array[String]): Unit = {
    val arr = Array(10, 20, 30, 40, 50)

    // Using sum()
    val sum1 = arr.sum
    println(s"Sum using sum(): $sum1")

    // Using for-loop
    var sum2 = 0
    for (x <- arr) {
      sum2 += x
    }
    println(s"Sum using for-loop: $sum2")
  }
}




