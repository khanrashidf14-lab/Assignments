import scala.util.Random 						 //for random nos.
object PerfectNumbers {
  def isPerfect(n: Int): Boolean = {
    if (n <= 1) return false					//0 and 1 are not included
    var sum = 0

    for (i <- 1 until n) {						
      if (n % i == 0) sum += i					//storing no. only if remainder is 0
    }
    sum == n									//to return true, when upper conditions satisfies
  }
  def main(args: Array[String]): Unit = {
    val rand = new Random()
    println("Five random numbers and perfect-number check:")

    for (i <- 1 to 5) {
      val num = rand.nextInt(30) + 1   			//only 2 numbers as perfect in the range:6,28
      val result = if (isPerfect(num)) "Perfect" else "Not Perfect"
      println(s"$i. Number = $num  -->  $result")
    }
  }
}



