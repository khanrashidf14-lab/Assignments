import scala.io.StdIn
object DayOfWeek{
    def getDayName(day:Int):String = day match{
        case 1=>"Monday"
        case 2=>"Tuesday"
        case 3=>"Wednesday"
        case 4=>"Thursday"
        case 5=>"Friday"
        case 6=>"Saturday"
        case 7=>"Sunday"
        case _=>"Invalid Day"
    }
    def main(args:Array[String]): Unit = {
        print("Enter day number(1-7):")
        val dayNum = StdIn.readInt()
        println(s"Day:${getDayName(dayNum)}")
    }
}



