object SumOfPrimes {
  
  def isPrime(n: Int): Boolean = {
    if (n <= 1) return false          //0 and 1 is not included
    if (n == 2) return true           //only 2 is a even prime no. 
    if (n % 2 == 0) return false      //a prime never gets 0 as remainder except 2
    var i = 3
    while (i * i <= n) {              //creates an i and starts from 3
      if (n % i == 0) return false    //n should not have rem = 0
      i += 2
    }
    true
  }

  def main(args: Array[String]): Unit = {
    var sum = 0
    for (num <- 1 to 100) {           //checking every no. from1 to 100
      if (isPrime(num)) {             //runs only if the no. is prime
        sum += num                    //sum happens here
        print(s"$num ")
      }
    }
    println(s"\nSum of prime numbers between 1 and 100 = $sum")
  }
}


