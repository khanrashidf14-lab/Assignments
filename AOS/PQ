#include <stdio.h>
#include <dirent.h>
#include <sys/stat.h>
#include <fcntl.h>
#include <unistd.h>

int main() {
    DIR *d = opendir(".");
    struct dirent *e;
    struct stat st;
    int count = 0;

    printf("%-20s %-10s %s\n", "Name", "Size", "Type");
    while ((e = readdir(d)) != NULL) {
        if (stat(e->d_name, &st) == 0) {
            printf("%-20s %-10ld ", e->d_name, st.st_size);
            if (S_ISREG(st.st_mode)) printf("Regular\n");
            else if (S_ISDIR(st.st_mode)) printf("Directory\n");
            else printf("Other\n");
            count++;
        }
    }
    closedir(d);
    printf("Total files/entries: %d\n", count);

    // Create file with a hole
    int fd = open("holefile", O_CREAT | O_WRONLY, 0644);
    write(fd, "START", 5);
    lseek(fd, 10000, SEEK_CUR);         // create hole
    write(fd, "END", 3);
    close(fd);
    printf("File 'holefile' with hole created.\n");

    return 0;
}
