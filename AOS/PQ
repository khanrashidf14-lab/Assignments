#include <stdio.h>
#include <dirent.h>
#include <stdlib.h>

int main() {
    DIR *d = opendir(".");
    struct dirent *e;
    char name[100], content[200];
    FILE *fp;

    printf("Files in current directory:\n");
    while ((e = readdir(d)) != NULL)
        printf("%s\n", e->d_name);
    closedir(d);

    printf("\nEnter filename to create: ");
    scanf("%s", name);
    getchar();                          // clear newline

    printf("Enter content: ");
    fgets(content, sizeof(content), stdin);

    fp = fopen(name, "w");
    if (!fp) { perror("fopen"); return 1; }
    fputs(content, fp);
    fclose(fp);
    printf("File created.\n");

    fp = fopen(name, "r");
    if (!fp) { perror("fopen"); return 1; }
    printf("\nFile content:\n");
    while (fgets(content, sizeof(content), fp))
        printf("%s", content);
    fclose(fp);

    return 0;
}


