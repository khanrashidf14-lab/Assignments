#include <stdio.h>
#include <stdlib.h>
#include <dirent.h>
#include <string.h>

int main(void) {
    DIR *dir;
    struct dirent *entry;
    char filename[256];
    char content[512];
    FILE *fp;

    /* 1. List all files */
    dir = opendir(".");
    if (dir == NULL) {
        perror("opendir");
        return 1;
    }

    printf("Files in current directory:\n");
    while ((entry = readdir(dir)) != NULL) {
        if (entry->d_name[0] != '.')
            printf("  %s\n", entry->d_name);
    }
    closedir(dir);

    /* 2. Create a file */
    printf("\nEnter name of file to create: ");
    scanf("%255s", filename);
    getchar();

    printf("Enter content: ");
    fgets(content, sizeof(content), stdin);

    fp = fopen(filename, "w");
    if (fp == NULL) {
        perror("fopen create");
        return 1;
    }
    fputs(content, fp);
    fclose(fp);
    printf("File created.\n");

    /* 3. Read and display */
    fp = fopen(filename, "r");
    if (fp == NULL) {
        perror("fopen read");
        return 1;
    }

    printf("\nContent of %s:\n", filename);
    char buf[256];
    while (fgets(buf, sizeof(buf), fp)) {
        fputs(buf, stdout);
    }
    fclose(fp);

    return 0;
}


