#include <stdio.h>
#include <stdlib.h>
#include <unistd.h>
#include <signal.h>
#include <sys/wait.h>

int main() {
    pid_t pid = fork();
    if (pid < 0) { perror("fork"); exit(1); }

    if (pid == 0) {                    // child
        while (1) {
            printf("Child running (pid %d)\n", getpid());
            sleep(1);
        }
    } else {                           // parent
        char ch;
        while (1) {
            printf("Enter s(stop)/r(resume)/q(quit): ");
            scanf(" %c", &ch);
            if (ch == 's') kill(pid, SIGSTOP);
            else if (ch == 'r') kill(pid, SIGCONT);
            else if (ch == 'q') {
                kill(pid, SIGTERM);
                wait(NULL);
                break;
            } else printf("Invalid input\n");
        }
    }
    return 0;
}



