#include <stdio.h>
#include <string.h>

#define BUF_SIZE 50

int main() {
    char buffer[BUF_SIZE];

    printf("Enter text: ");
    fgets(buffer, BUF_SIZE, stdin);
    buffer[strcspn(buffer, "\n")] = '\0';

    printf("Buffer content: %s\n", buffer);

    memset(buffer, 0, BUF_SIZE);          // clear buffer
    printf("Cleared buffer: \"%s\"\n", buffer);

    return 0;
}


