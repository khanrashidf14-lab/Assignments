#include <stdio.h>
#include <stdlib.h>
#include <string.h>

void print_menu(void) {
    printf("\n===== Dynamic Memory Menu =====\n");
    printf("1. Allocate memory (malloc)\n");
    printf("2. Reallocate memory (realloc)\n");
    printf("3. Free memory\n");
    printf("4. Display current content\n");
    printf("5. Exit\n");
    printf("Choice: ");
}

int main(void) {
    char *ptr = NULL;
    size_t current_size = 0;
    int choice;
    size_t new_size;
    char temp[256];

    while (1) {
        print_menu();
        if (scanf("%d", &choice) != 1) {
            while (getchar() != '\n');
            printf("Invalid input.\n");
            continue;
        }

        switch (choice) {
            case 1:
                if (ptr != NULL) {
                    printf("Memory already allocated. Free it first.\n");
                    break;
                }
                printf("Enter size in bytes: ");
                if (scanf("%zu", &new_size) != 1 || new_size == 0) {
                    printf("Invalid size.\n");
                    break;
                }
                ptr = (char *)malloc(new_size);
                if (ptr == NULL) {
                    perror("malloc failed");
                    break;
                }
                current_size = new_size;
                memset(ptr, 0, current_size);
                printf("Allocated %zu bytes successfully.\n", current_size);
                printf("Enter string to store: ");
                getchar(); /* consume newline */
                fgets(temp, sizeof(temp), stdin);
                temp[strcspn(temp, "\n")] = '\0';
                strncpy(ptr, temp, current_size - 1);
                break;

            case 2:
                if (ptr == NULL) {
                    printf("No memory allocated yet.\n");
                    break;
                }
                printf("Enter new size: ");
                if (scanf("%zu", &new_size) != 1 || new_size == 0) {
                    printf("Invalid size.\n");
                    break;
                }
                char *tmp = (char *)realloc(ptr, new_size);
                if (tmp == NULL) {
                    perror("realloc failed");
                    break;
                }
                ptr = tmp;
                if (new_size > current_size)
                    memset(ptr + current_size, 0, new_size - current_size);
                current_size = new_size;
                printf("Reallocated to %zu bytes.\n", current_size);
                break;

            case 3:
                if (ptr == NULL) {
                    printf("Nothing to free.\n");
                    break;
                }
                free(ptr);
                ptr = NULL;
                current_size = 0;
                printf("Memory freed.\n");
                break;

            case 4:
                if (ptr == NULL)
                    printf("No memory allocated.\n");
                else
                    printf("Content: \"%s\" (size: %zu)\n", ptr, current_size);
                break;

            case 5:
                if (ptr != NULL) {
                    free(ptr);
                    printf("Freed remaining memory before exit.\n");
                }
                printf("Goodbye.\n");
                return 0;

            default:
                printf("Invalid choice.\n");
        }
    }
}

