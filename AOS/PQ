#include <stdio.h>
#include <stdlib.h>

int main() {
    int *arr, n, i, new_n;

    printf("Enter size: ");
    scanf("%d", &n);

    arr = (int *)malloc(n * sizeof(int));
    if (!arr) { printf("malloc failed\n"); return 1; }

    printf("Enter %d elements: ", n);
    for (i = 0; i < n; i++) scanf("%d", &arr[i]);

    printf("Array: ");
    for (i = 0; i < n; i++) printf("%d ", arr[i]);
    printf("\n");

    printf("Enter new size: ");
    scanf("%d", &new_n);

    arr = (int *)realloc(arr, new_n * sizeof(int));
    if (!arr) { printf("realloc failed\n"); return 1; }

    if (new_n > n) {
        printf("Enter %d more elements: ", new_n - n);
        for (i = n; i < new_n; i++) scanf("%d", &arr[i]);
    }

    printf("New array: ");
    for (i = 0; i < new_n; i++) printf("%d ", arr[i]);
    printf("\n");

    free(arr);
    printf("Memory freed\n");
    return 0;
}


