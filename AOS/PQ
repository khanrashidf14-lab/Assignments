#include <stdio.h>
#include <unistd.h>
#include <signal.h>

static volatile sig_atomic_t resumed = 0;

void handler(int sig) {
    if (sig == SIGTSTP) {
        static const char message[] = "\nSuspending (send SIGCONT to resume)\n";
        write(STDOUT_FILENO, message, sizeof(message) - 1);
        kill(getpid(), SIGSTOP);
    } else if (sig == SIGCONT) {
        resumed = 1;
    }
}

int main() {
    signal(SIGTSTP, handler);
    signal(SIGCONT, handler);

    printf("Running... Press Ctrl+Z to suspend\n");
    while (1) {
        printf("Working...\n");
        sleep(2);
    }
    return 0;
}



