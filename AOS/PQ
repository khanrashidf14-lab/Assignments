#include <stdio.h>
#include <stdlib.h>

char *ptr = NULL;

void exit1() {
    if (ptr != NULL) {
        free(ptr);
        printf("Exit1: Memory freed\n");
    } else {
        printf("Exit1: Nothing to free\n");
    }
}

void exit2() { printf("Exit2: Second handler\n"); }
void exit3() { printf("Exit3: First registered (runs last)\n"); }

int main() {
    ptr = (char *)malloc(100);
    atexit(exit1);
    atexit(exit2);
    atexit(exit3);

    printf("Main executing...\n");
    return 0;                           // handlers run in reverse order
}

