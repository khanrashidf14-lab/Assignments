#include <stdio.h>
#include <stdlib.h>
#include <dirent.h>
#include <sys/stat.h>
#include <unistd.h>
#include <fcntl.h>
#include <string.h>

const char *file_type(mode_t mode) {
    if (S_ISREG(mode))  return "Regular File";
    if (S_ISDIR(mode))  return "Directory";
    if (S_ISLNK(mode))  return "Symbolic Link";
    if (S_ISCHR(mode))  return "Character Device";
    if (S_ISBLK(mode))  return "Block Device";
    if (S_ISFIFO(mode)) return "FIFO/Pipe";
    if (S_ISSOCK(mode)) return "Socket";
    return "Unknown";
}

int main(void) {
    DIR *dir = opendir(".");
    if (dir == NULL) {
        perror("opendir");
        return 1;
    }

    struct dirent *entry;
    struct stat st;
    int total = 0;

    printf("%-30s %-12s %s\n", "Name", "Size (bytes)", "Type");
    printf("------------------------------------------------------------\n");

    while ((entry = readdir(dir)) != NULL) {
        if (strcmp(entry->d_name, ".") == 0 || strcmp(entry->d_name, "..") == 0)
            continue;

        if (stat(entry->d_name, &st) == -1) {
            perror(entry->d_name);
            continue;
        }

        printf("%-30s %-12ld %s\n",
               entry->d_name,
               (long)st.st_size,
               file_type(st.st_mode));
        total++;
    }
    closedir(dir);

    printf("------------------------------------------------------------\n");
    printf("Total files/directories: %d\n\n", total);

    /* Create a file with a hole */
    const char *hole_file = "file_with_hole.dat";
    int fd = open(hole_file, O_WRONLY | O_CREAT | O_TRUNC, 0644);
    if (fd == -1) {
        perror("open");
        return 1;
    }

    /* Write some data at the beginning */
    const char *data1 = "START";
    write(fd, data1, strlen(data1));

    /* Seek far ahead → creates a hole */
    if (lseek(fd, 4096, SEEK_SET) == -1) {
        perror("lseek");
        close(fd);
        return 1;
    }

    /* Write data after the hole */
    const char *data2 = "END";
    write(fd, data2, strlen(data2));
    close(fd);

    /* Show the result */
    if (stat(hole_file, &st) == 0) {
        printf("Created sparse file: %s\n", hole_file);
        printf("Logical size (st_size): %ld bytes\n", (long)st.st_size);
        printf("Note: Actual disk usage is much smaller due to the hole.\n");
    }

    return 0;
}
