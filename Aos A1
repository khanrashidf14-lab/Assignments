#include <stdio.h>
#include <stdlib.h>
#include <unistd.h>
#include <sys/wait.h>

typedef struct {
    int type;   // 1 = deposit, 2 = withdrawal, 3 = EMI
    int amount;
} Request;

void deposit(int fd)
{
    Request r;

    r.type = 1;
    r.amount = 2000;

    write(fd, &r, sizeof(r));
    printf("[Deposit] Sent deposit request: %d\n", r.amount);

    close(fd);
    exit(0);
}

void withdrawal(int fd)
{
    Request r;

    r.type = 2;
    r.amount = 1200;

    write(fd, &r, sizeof(r));
    printf("[Withdrawal] Sent withdrawal request: %d\n", r.amount);

    close(fd);
    exit(0);
}

void emi(int fd)
{
    Request r;

    r.type = 3;
    r.amount = 800;

    write(fd, &r, sizeof(r));
    printf("[EMI] Sent EMI request: %d\n", r.amount);

    close(fd);
    exit(0);
}

int main()
{
    int pipefd[2];
    pid_t p1, p2, p3;

    int balance = 500;
    Request r;

    if (pipe(pipefd) == -1) {
        perror("pipe");
        exit(1);
    }

    printf("Initial balance = %d\n", balance);

    /* Deposit child */
    p1 = fork();

    if (p1 == 0) {
        close(pipefd[0]);   // child doesn't read
        deposit(pipefd[1]);
    }

    /* Withdrawal child */
    p2 = fork();

    if (p2 == 0) {
        close(pipefd[0]);
        withdrawal(pipefd[1]);
    }

    /* EMI child */
    p3 = fork();

    if (p3 == 0) {
        close(pipefd[0]);
        emi(pipefd[1]);
    }

    /* Parent doesn't write */
    close(pipefd[1]);

    /*
     * Parent receives requests from children
     */
    while (read(pipefd[0], &r, sizeof(r)) > 0) {

        if (r.type == 1) {
            balance += r.amount;

            printf("[Parent] Deposit %d -> balance = %d\n",
                   r.amount, balance);
        }

        else if (r.type == 2) {
            if (balance >= r.amount) {
                balance -= r.amount;

                printf("[Parent] Withdrawal %d successful -> balance = %d\n",
                       r.amount, balance);
            }
            else {
                printf("[Parent] Withdrawal %d failed -> balance = %d\n",
                       r.amount, balance);
            }
        }

        else if (r.type == 3) {
            if (balance >= r.amount) {
                balance -= r.amount;

                printf("[Parent] EMI %d successful -> balance = %d\n",
                       r.amount, balance);
            }
            else {
                printf("[Parent] EMI %d failed -> balance = %d\n",
                       r.amount, balance);
            }
        }
    }

    close(pipefd[0]);

    waitpid(p1, NULL, 0);
    waitpid(p2, NULL, 0);
    waitpid(p3, NULL, 0);

    printf("Final balance = %d\n", balance);

    return 0;
}
