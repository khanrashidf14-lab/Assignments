#include <stdio.h>
#include <stdlib.h>
#include <unistd.h>
#include <sys/wait.h>
#include <fcntl.h>   // F_GETPIPE_SZ

typedef struct {
    int type;   // 1 = deposit, 2 = withdrawal, 3 = EMI
    int amount;
} Request;

void deposit(int fd)
{
    Request r;
    r.type = 1;
    r.amount = 2000;
    
    // Display Child Buffer Info
    printf("[Child 1 - Deposit] Stack Buffer Address: %p | Size: %lu bytes\n", (void*)&r, sizeof(r));

    write(fd, &r, sizeof(r));
    printf("[Deposit] Sent deposit request: %d\n", r.amount);
    close(fd);
    exit(0);
}

void withdrawal(int fd)
{
    Request r;
    r.type = 2;
    r.amount = 1200;

    // Display Child Buffer Info
    printf("[Child 2 - Withdrawal] Stack Buffer Address: %p | Size: %lu bytes\n", (void*)&r, sizeof(r));

    write(fd, &r, sizeof(r));
    printf("[Withdrawal] Sent withdrawal request: %d\n", r.amount);
    close(fd);
    exit(0);
}

void emi(int fd)
{
    Request r;
    r.type = 3;
    r.amount = 800;

    // Display Child Buffer Info
    printf("[Child 3 - EMI] Stack Buffer Address: %p | Size: %lu bytes\n", (void*)&r, sizeof(r));

    write(fd, &r, sizeof(r));
    printf("[EMI] Sent EMI request: %d\n", r.amount);
    close(fd);
    exit(0);
}

int main()
{
    int pipefd[2];
    pid_t p1, p2, p3;
    int balance = 0;
    Request r;

    if (pipe(pipefd) == -1) {
        perror("pipe");
        exit(1);
    }

    // Display Kernel Pipe Buffer Capacity (Linux specific: F_GETPIPE_SZ)
    #ifdef F_GETPIPE_SZ
    int pipe_capacity = fcntl(pipefd[0], F_GETPIPE_SZ);
    printf("=== BUFFER ALLOCATION SUMMARY ===\n");
    printf("[Kernel Space] Pipe Buffer Size: %d bytes (%d KB)\n", pipe_capacity, pipe_capacity / 1024);
    #endif

    // Display Parent Buffer Info
    printf("[Parent Space] Stack Buffer Address (&r): %p | Size: %lu bytes\n", (void*)&r, sizeof(r));
    printf("=================================\n\n");

    printf("Initial balance = %d\n", balance);

    p1 = fork();
    if (p1 == 0) {
        close(pipefd[0]);
        deposit(pipefd[1]);
    }

    p2 = fork();
    if (p2 == 0) {
        close(pipefd[0]);
        withdrawal(pipefd[1]);
    }

    p3 = fork();
    if (p3 == 0) {
        close(pipefd[0]);
        emi(pipefd[1]);
    }

    close(pipefd[1]);

    while (read(pipefd[0], &r, sizeof(r)) > 0) {
        if (r.type == 1) {
            balance += r.amount;
            printf("[Parent] Deposit %d -> balance = %d\n", r.amount, balance);
        }
        else if (r.type == 2) {
            if (balance >= r.amount) {
                balance -= r.amount;
                printf("[Parent] Withdrawal %d successful -> balance = %d\n", r.amount, balance);
            } else {
                printf("[Parent] Withdrawal %d failed -> balance = %d\n", r.amount, balance);
            }
        }
        else if (r.type == 3) {
            if (balance >= r.amount) {
                balance -= r.amount;
                printf("[Parent] EMI %d successful -> balance = %d\n", r.amount, balance);
            } else {
                printf("[Parent] EMI %d failed -> balance = %d\n", r.amount, balance);
            }
        }
    }

    close(pipefd[0]);
    waitpid(p1, NULL, 0);
    waitpid(p2, NULL, 0);
    waitpid(p3, NULL, 0);

    printf("\nFinal balance = %d\n", balance);
    return 0;
}
