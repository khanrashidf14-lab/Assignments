object ReverseWords {
  def reverseWords(str: String): String = {
    str.split("\\s+").map(_.reverse).mkString(" ")
  }

  def main(args: Array[String]): Unit = {
    val input = "Hello World from Scala"
    println(s"Original : $input")
    println(s"Reversed : ${reverseWords(input)}")
  }
}



